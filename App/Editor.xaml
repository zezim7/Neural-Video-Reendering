<Window x:Class="VideoNR.Editor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vídeo NR — Editor"
        Width="1360" Height="820" MinWidth="960" MinHeight="620" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="EditorKeyDown" AllowDrop="True" Drop="DropFiles">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Studio Palette: Neutral Graphite + Electric Blue -->
        <SolidColorBrush x:Key="Canvas" Color="#0A0C10"/>
        <SolidColorBrush x:Key="Surface" Color="#12151C"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="#171B24"/>
        <SolidColorBrush x:Key="SurfaceRecessed" Color="#0D1016"/>
        <SolidColorBrush x:Key="Divider" Color="#222733"/>
        <SolidColorBrush x:Key="Line" Color="#2C3344"/>
        <SolidColorBrush x:Key="Text" Color="#F2F5FA"/>
        <SolidColorBrush x:Key="Muted" Color="#8E98AB"/>
        <SolidColorBrush x:Key="Subtle" Color="#5F697D"/>
        <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#5B9BFF"/>
        <SolidColorBrush x:Key="AccentMuted" Color="#193058"/>
        <SolidColorBrush x:Key="AccentBorder" Color="#3B82F6"/>
        <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ControlFill" Color="#1C212C"/>
        <SolidColorBrush x:Key="ControlHover" Color="#242B3A"/>
        <SolidColorBrush x:Key="SwitchOff" Color="#272E3D"/>
        <SolidColorBrush x:Key="SwitchLine" Color="#3B4559"/>
        <SolidColorBrush x:Key="SwitchThumb" Color="#DCE3F0"/>
        <SolidColorBrush x:Key="SuccessDot" Color="#22C55E"/>
        <SolidColorBrush x:Key="WarnDot" Color="#F59E0B"/>
        <SolidColorBrush x:Key="DangerLine" Color="#E05252"/>
        <SolidColorBrush x:Key="DangerFill" Color="#351B22"/>
        <SolidColorBrush x:Key="Preview" Color="#050608"/>
        <SolidColorBrush x:Key="Overlay" Color="#CC0D1016"/>
        <SolidColorBrush x:Key="RangeFill" Color="#203C6E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Divider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource ControlFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Background" Value="{StaticResource ControlHover}"/>
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource SwitchLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Outline" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Background" Value="{StaticResource AccentHover}"/>
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Outline" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Background" Value="{StaticResource ControlFill}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Outline" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Background" Value="{StaticResource DangerFill}"/>
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource DangerLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource DangerLine}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Outline" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentedOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="5" Padding="12,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource ControlFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="10,6,28,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Box" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="6">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource Muted}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Box" Property="Background" Value="{StaticResource ControlHover}"/>
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SwitchLine}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource SurfaceElevated}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="7" Margin="0,3,0,0" Padding="2"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="18">
                                                    <Border Height="3" CornerRadius="1.5,0,0,1.5" Background="{StaticResource Accent}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="18">
                                                    <Border Height="3" CornerRadius="0,1.5,1.5,0" Background="{StaticResource SwitchOff}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Dot" Fill="#FFFFFF" Stroke="{StaticResource Accent}" StrokeThickness="2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource AccentHover}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{StaticResource SurfaceRecessed}"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Bar" Background="{StaticResource Line}" CornerRadius="3"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Subtle}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="MinHeight" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,1">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Bar" Background="{StaticResource Line}" CornerRadius="3"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Subtle}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource SwitchLine}" Background="{StaticResource SwitchOff}" Width="36" Height="20" Padding="2">
                            <Ellipse x:Name="Thumb" Fill="{StaticResource SwitchThumb}" Width="14" Height="14" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Margin="0,2" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="AccentBar" Width="3" CornerRadius="1.5" Background="{StaticResource Accent}"
                                        HorizontalAlignment="Left" Margin="-10,1,0,1" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource ControlFill}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{StaticResource AccentMuted}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#2D4F8A"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrimHandle" TargetType="Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" Background="{StaticResource Accent}" CornerRadius="3" BorderBrush="{StaticResource AccentHover}" BorderThickness="1">
                            <Border Background="#FFFFFF" Opacity="0.7" Width="2" Height="12" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimecodeBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceRecessed}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentMuted}"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource SwitchLine}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Studio Top Bar -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1" Padding="14,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceElevated}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="EngineDot" Width="7" Height="7" Fill="{StaticResource SuccessDot}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="EngineLabel" Text="Motor de NR" FontSize="12" Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="EngineButton" Content="Localizar motor" Visibility="Collapsed" Click="FindEngineClick" Padding="10,4" Margin="8,0,0,0" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6" Background="{StaticResource Accent}" Margin="0,0,10,0">
                        <Path Data="M 6 4 L 16 10 L 6 16 Z" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="11" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Vídeo NR" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource AccentMuted}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STUDIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHover}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3-Pane Studio Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="336"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Queue -->
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12,12,10" BorderBrush="{StaticResource Divider}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="AddButton" DockPanel.Dock="Right" Click="AddFiles" Padding="9,5" FontSize="12" ToolTip="Adicionar vídeos à fila">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 5 0 V 10 M 0 5 H 10" Stroke="{StaticResource Text}" StrokeThickness="1.6" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Adicionar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="QueueTitle" Text="Fila" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="12,10" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RemoveButton" Style="{StaticResource DangerButton}" Click="RemoveSelected" Padding="8,5" FontSize="12" Margin="0,0,6,0" ToolTip="Remover selecionado (Delete)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 2 3 H 10 M 4 3 V 2 H 8 V 3 M 3 3 L 3.5 11 H 8.5 L 9 3" Stroke="{StaticResource Text}" StrokeThickness="1.2" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Remover" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearButton" Grid.Column="1" Content="Limpar" Click="ClearQueue" Padding="10,5" FontSize="12"/>
                        </Grid>
                    </Border>

                    <Grid Margin="8,6">
                        <StackPanel x:Name="EmptyQueue" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                            <Path Data="M 2 4 H 18 V 16 H 2 Z M 6 4 V 16 M 14 4 V 16 M 2 8 H 6 M 14 8 H 18 M 2 12 H 6 M 14 12 H 18"
                                  Stroke="{StaticResource Subtle}" StrokeThickness="1.4" Width="28" Height="22" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Fila vazia" FontWeight="SemiBold" HorizontalAlignment="Center" Style="{StaticResource Secondary}" FontSize="12"/>
                            <TextBlock Text="Solte vídeos ou pastas aqui" HorizontalAlignment="Center" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,3,0,0" TextAlignment="Center"/>
                        </StackPanel>
                        <ListBox x:Name="Queue" Background="Transparent" BorderThickness="0" SelectionChanged="SelectClip" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Center Pane: Video Stage + Timeline Deck -->
            <Grid Grid.Column="1" Background="{StaticResource Canvas}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview Stage -->
                <Border Background="{StaticResource Preview}" Margin="12,12,12,0" CornerRadius="10" BorderBrush="{StaticResource Divider}" BorderThickness="1" ClipToBounds="True"
                        MouseLeftButtonUp="PreviewClick">
                    <Grid>
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"
                                      MediaOpened="MediaReady" MediaFailed="MediaFailure" MediaEnded="MediaFinished"/>

                        <StackPanel x:Name="VideoPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource SurfaceElevated}" BorderBrush="{StaticResource Divider}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Data="M 4 3 L 16 10 L 4 17 Z" Fill="{StaticResource Accent}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="VideoMessage" Text="Abra um vídeo para começar" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="VideoSubMessage" Text="Arraste arquivos ou pastas para esta janela" Style="{StaticResource Secondary}" FontSize="12" TextAlignment="Center" Margin="0,5,0,16"/>
                            <Button x:Name="EmptyOpenButton" Content="Selecionar vídeos" Style="{StaticResource Primary}" Click="AddFiles" Padding="16,8" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Border x:Name="VideoTag" Visibility="Collapsed" Background="{StaticResource Overlay}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                Padding="9,4" CornerRadius="6" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0"/>
                                <TextBlock Text="Original" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Timeline & Transport Deck -->
                <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="16,11,16,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Text="00:00:00 / 00:00:00" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CORTE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TrimLabel" Text="" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="{StaticResource SurfaceRecessed}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="6">
                            <Canvas x:Name="TrimTrack" Height="40" Margin="6,0" Background="Transparent" SizeChanged="ResizeTrim"
                                    MouseLeftButtonDown="ScrubDown" MouseLeftButtonUp="ScrubUp" MouseMove="ScrubMove" LostMouseCapture="ScrubLost">
                                <Border x:Name="TrimRange" Canvas.Top="4" Height="32" CornerRadius="3" Background="{StaticResource RangeFill}"
                                        BorderBrush="{StaticResource Accent}" BorderThickness="0,2" IsHitTestVisible="False"/>
                                <Grid x:Name="Playhead" Width="10" Height="40" IsHitTestVisible="False" Panel.ZIndex="1">
                                    <Polygon Points="0,0 10,0 5,6" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <Border Width="2" Height="36" Background="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                </Grid>
                                <Thumb x:Name="StartHandle" Style="{StaticResource TrimHandle}" Canvas.Top="2" Panel.ZIndex="2" Tag="start" DragStarted="TrimDragStarted"
                                       DragDelta="TrimDrag" ToolTip="Arraste o início do trecho" AutomationProperties.Name="Alça de início do corte"/>
                                <Thumb x:Name="EndHandle" Style="{StaticResource TrimHandle}" Canvas.Top="2" Panel.ZIndex="2" Tag="end" DragStarted="TrimDragStarted"
                                       DragDelta="TrimDrag" ToolTip="Arraste o fim do trecho" AutomationProperties.Name="Alça de fim do corte"/>
                            </Canvas>
                        </Border>

                        <DockPanel Margin="0,10,0,0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PlayButton" Click="PlayClick" Padding="11,5" Margin="0,0,6,0" ToolTip="Reproduzir ou pausar (Espaço)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path x:Name="PlayIcon" Data="M 2 1 L 10 6 L 2 11 Z" Fill="{StaticResource Text}" Width="9" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="PlayLabel" Text="Reproduzir" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MuteButton" Click="MuteClick" Padding="8,5" ToolTip="Silenciar ou ativar áudio (M)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M 1 4 H 4 L 8 1 V 11 L 4 8 H 1 Z" Fill="{StaticResource Muted}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="MuteLabel" Text="Som" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MarkStartButton" Content="[ Início" Click="MarkStartClick" Padding="8,5" FontSize="12" Margin="0,0,6,0" ToolTip="Marcar início no ponto atual (I)"/>
                                <TextBox x:Name="StartTime" Tag="start" Style="{StaticResource TimecodeBox}" AutomationProperties.Name="Início do corte"
                                         LostKeyboardFocus="TimecodeLostFocus" KeyDown="TimecodeKeyDown"/>
                                <TextBlock Text="–" VerticalAlignment="Center" Foreground="{StaticResource Subtle}" Margin="5,0"/>
                                <TextBox x:Name="EndTime" Tag="end" Style="{StaticResource TimecodeBox}" AutomationProperties.Name="Fim do corte"
                                         LostKeyboardFocus="TimecodeLostFocus" KeyDown="TimecodeKeyDown"/>
                                <Button x:Name="MarkEndButton" Content="Fim ]" Click="MarkEndClick" Padding="8,5" FontSize="12" Margin="6,0,6,0" ToolTip="Marcar fim no ponto atual (O)"/>
                                <Button x:Name="ResetTrimButton" Content="Resetar" Click="ResetTrim" Padding="8,5" FontSize="12" ToolTip="Voltar para o vídeo inteiro"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right Pane: NR Inspector + Export Dock -->
            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Export Dock Fixed at Bottom -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceElevated}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="14,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceRecessed}" BorderBrush="{StaticResource Divider}" BorderThickness="1" CornerRadius="6" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="H264Radio" Content="H.264" GroupName="CodecGroup" IsChecked="True" Style="{StaticResource SegmentedOption}" AutomationProperties.Name="Codec H.264"/>
                                        <RadioButton x:Name="HevcRadio" Content="HEVC" GroupName="CodecGroup" Style="{StaticResource SegmentedOption}" AutomationProperties.Name="Codec HEVC"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="EXPORTAÇÃO" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Formato MP4" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="10000" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ExportButton" Content="Iniciar exportação" Style="{StaticResource Primary}" Click="ExportClick" Height="36"/>
                                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Style="{StaticResource DangerButton}" Click="CancelWork" Margin="8,0,0,0" Height="36" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- NR Header & Model Picker -->
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
                        <DockPanel>
                            <CheckBox x:Name="NrSwitch" DockPanel.Dock="Right" IsChecked="True" Style="{StaticResource Switch}" Click="ToggleNr" AutomationProperties.Name="Ativar melhoria NR"/>
                            <StackPanel>
                                <TextBlock Text="Melhoria NR" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LayerSummary" Text="1 camada ativa" Style="{StaticResource Secondary}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="VERSÃO DO MOTOR NR" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"/>
                        <ComboBox x:Name="NrVersion" DisplayMemberPath="Label" SelectionChanged="ChangeVersion" AutomationProperties.Name="Versão do NR"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="14,6,14,10">
                        <Button x:Name="AddLayerButton" Click="AddLayerClick" Padding="10,7" FontSize="12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 5 0 V 10 M 0 5 H 10" Stroke="{StaticResource AccentHover}" StrokeThickness="1.6" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Adicionar camada NR" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Scrollable NR Layer Stack -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,4">
                        <ItemsControl x:Name="LayerCards">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource Switch}"
                                                          VerticalAlignment="Center" Margin="6,0,0,0" Click="LayerToggleClick"
                                                          AutomationProperties.Name="{Binding ToggleAccessibilityName}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Duplicar camada"
                                                        VerticalAlignment="Center" IsEnabled="{Binding CanDuplicate}" Click="DuplicateLayerClick"
                                                        AutomationProperties.Name="{Binding DuplicateAccessibilityName}">
                                                    <Path Data="M 3 3 H 10 V 10 H 3 Z M 1 1 H 8 V 2 M 1 1 V 8 H 2" Stroke="{StaticResource Muted}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform"/>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Padding="4,3,6,3" Margin="0,0,4,0"
                                                        Click="ToggleLayerExpandClick" ToolTip="Abrir ajustes da camada"
                                                        AutomationProperties.Name="{Binding HeaderAccessibilityName}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Chevron}" Style="{StaticResource Secondary}"
                                                                   VerticalAlignment="Center" Margin="0,0,7,0" FontSize="11"/>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" FontSize="11"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DockPanel>

                                            <StackPanel Margin="2,10,2,2" Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibility}}">
                                                <Border Height="1" Background="{StaticResource Divider}" Margin="0,0,0,10"/>
                                                <TextBlock Text="RESOLUÇÃO INTERNA" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                                                <ComboBox ItemsSource="{Binding AvailableResolutions}" SelectedIndex="{Binding ResolutionIndex, Mode=TwoWay}"/>

                                                <StackPanel Margin="0,10,0,0">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding IntensityValue}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text}"/>
                                                        <TextBlock Text="Intensidade" Style="{StaticResource Secondary}" FontSize="12"/>
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="1" Value="{Binding Intensity, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="Intensidade"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,8,0,0">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ToneValue}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text}"/>
                                                        <TextBlock Text="Tom" Style="{StaticResource Secondary}" FontSize="12"/>
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="1" Value="{Binding Tone, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="Tom"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,8,0,0">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StructureValue}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text}"/>
                                                        <TextBlock Text="Estrutura" Style="{StaticResource Secondary}" FontSize="12"/>
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="1" Value="{Binding Structure, Mode=TwoWay}" TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="Estrutura"/>
                                                </StackPanel>

                                                <Button Style="{StaticResource DangerButton}" Padding="9,4" FontSize="11"
                                                        HorizontalAlignment="Right" Margin="0,10,0,0" Click="RemoveLayerClick">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="M 2 3 H 10 M 4 3 V 2 H 8 V 3 M 3 3 L 3.5 11 H 8.5 L 9 3" Stroke="{StaticResource Text}" StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Remover camada" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Studio Status Strip -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="ShowOutputButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="8,2" Click="OpenOutput" Visibility="Collapsed" FontSize="11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M 1 2 H 5 L 6.5 4 H 13 V 11 H 1 Z" Stroke="{StaticResource AccentHover}" StrokeThickness="1.2" Width="12" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Abrir pasta de saída" Foreground="{StaticResource AccentHover}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="Status" Text="Adicione um vídeo para começar." Style="{StaticResource Secondary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
