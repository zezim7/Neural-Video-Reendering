<Window x:Class="VideoNR.Editor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Vídeo NR — Editor"
        Width="1360" Height="820" MinWidth="940" MinHeight="610" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="EditorKeyDown" AllowDrop="True" Drop="DropFiles">
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#0F1C2B"/>
        <SolidColorBrush x:Key="Panel" Color="#192C3B"/>
        <SolidColorBrush x:Key="Line" Color="#456071"/>
        <SolidColorBrush x:Key="Text" Color="#F1F6F8"/>
        <SolidColorBrush x:Key="Muted" Color="#B8CCD5"/>
        <SolidColorBrush x:Key="Accent" Color="#61E0C3"/>
        <SolidColorBrush x:Key="ControlFill" Color="#253D4D"/>
        <SolidColorBrush x:Key="OnAccent" Color="#082C2B"/>
        <SolidColorBrush x:Key="AccentLight" Color="#AAF3DF"/>
        <SolidColorBrush x:Key="SwitchLine" Color="#829CA9"/>
        <SolidColorBrush x:Key="SwitchOff" Color="#314958"/>
        <SolidColorBrush x:Key="SwitchThumb" Color="#D8E5EA"/>
        <SolidColorBrush x:Key="SelectedFill" Color="#204942"/>
        <SolidColorBrush x:Key="SelectedLine" Color="#58A998"/>
        <SolidColorBrush x:Key="GripLine" Color="#226055"/>
        <SolidColorBrush x:Key="Preview" Color="#090D11"/>
        <SolidColorBrush x:Key="Overlay" Color="#DD11242F"/>
        <SolidColorBrush x:Key="RangeFill" Color="#246557"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource ControlFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outline" Property="Opacity" Value="0.44"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/><Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{StaticResource AccentLight}"/>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource SwitchLine}" Background="{StaticResource SwitchOff}" Width="39" Height="22" Padding="3">
                        <Ellipse x:Name="Thumb" Fill="{StaticResource SwitchThumb}" Width="14" Height="14" HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{StaticResource OnAccent}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Margin="0,2" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource ControlFill}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectedFill}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource SelectedLine}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="TrimHandle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="{StaticResource Accent}" CornerRadius="4" BorderBrush="{StaticResource AccentLight}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="{StaticResource GripLine}" Width="1" Height="12" Margin="0,0,2,0"/>
                            <Border Background="{StaticResource GripLine}" Width="1" Height="12"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{StaticResource AccentLight}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="TimecodeBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource ControlFill}"/><Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="Width" Value="105"/><Setter Property="Padding" Value="5,4"/>
            <Setter Property="FontFamily" Value="Consolas"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16,12,16,10">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="2,0,2,13" LastChildFill="True">

            <TextBlock x:Name="EngineLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Secondary}" Margin="0,0,12,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Vídeo NR" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Editor e exportação" VerticalAlignment="Center" Style="{StaticResource Secondary}" Margin="14,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/><ColumnDefinition Width="308"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelStyle}" Margin="0,0,10,0" Padding="11">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="AddButton" DockPanel.Dock="Right" Content="+ Adicionar" Click="AddFiles" Padding="8,6"/>
                        <TextBlock x:Name="QueueTitle" Text="Fila" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,9,0,0">
                        <Button x:Name="RemoveButton" Content="Remover" Click="RemoveSelected" Padding="8,6" Margin="0,0,6,0"/>
                        <Button x:Name="ClearButton" Content="Limpar" Click="ClearQueue" Padding="8,6"/>
                    </StackPanel>
                    <Grid>
                        <TextBlock x:Name="EmptyQueue" Text="Solte vídeos aqui" Style="{StaticResource Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ListBox x:Name="Queue" Background="Transparent" BorderThickness="0" SelectionChanged="SelectClip" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="{StaticResource Preview}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                    <Grid Margin="1">
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"
                                      MediaOpened="MediaReady" MediaFailed="MediaFailure" MediaEnded="MediaFinished"/>
                        <StackPanel x:Name="VideoPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                            <TextBlock x:Name="VideoMessage" Text="Abra um vídeo para visualizar" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border x:Name="VideoTag" Visibility="Collapsed" Background="{StaticResource Overlay}" Padding="9,4" CornerRadius="5" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="Original" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,9,0,0" Padding="12,9">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Text="00:00:00 / 00:00:00" FontFamily="Consolas"
                                       Style="{StaticResource Secondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="Corte" FontWeight="SemiBold" FontSize="15"/>
                        </DockPanel>
                        <Canvas x:Name="TrimTrack" Height="42" Margin="8,0" Background="{StaticResource ControlFill}" SizeChanged="ResizeTrim"
                                MouseLeftButtonDown="ScrubDown" MouseLeftButtonUp="ScrubUp" MouseMove="ScrubMove" LostMouseCapture="ScrubLost">
                            <Border x:Name="TrimRange" Canvas.Top="5" Height="32" CornerRadius="4" Background="{StaticResource RangeFill}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="0,2" IsHitTestVisible="False"/>
                            <Border x:Name="Playhead" Width="2" Height="42" Background="#FFFFFF" IsHitTestVisible="False" Panel.ZIndex="1"/>
                            <Thumb x:Name="StartHandle" Style="{StaticResource TrimHandle}" Canvas.Top="2" Panel.ZIndex="2" Tag="start" DragStarted="TrimDragStarted"
                                   DragDelta="TrimDrag" ToolTip="Arraste o início do trecho" AutomationProperties.Name="Alça de início do corte"/>
                            <Thumb x:Name="EndHandle" Style="{StaticResource TrimHandle}" Canvas.Top="2" Panel.ZIndex="2" Tag="end" DragStarted="TrimDragStarted"
                                   DragDelta="TrimDrag" ToolTip="Arraste o fim do trecho" AutomationProperties.Name="Alça de fim do corte"/>
                        </Canvas>
                        <WrapPanel Margin="0,9,0,0">
                            <Button x:Name="PlayButton" Content="Reproduzir" Click="PlayClick" Padding="9,5" Margin="0,0,9,4"/>
                            <TextBox x:Name="StartTime" Tag="start" Style="{StaticResource TimecodeBox}" AutomationProperties.Name="Início do corte"
                                     LostKeyboardFocus="TimecodeLostFocus" KeyDown="TimecodeKeyDown" Margin="0,0,4,4"/>
                            <TextBlock Text="–" VerticalAlignment="Center" Margin="2,0,6,4"/>
                            <TextBox x:Name="EndTime" Tag="end" Style="{StaticResource TimecodeBox}" AutomationProperties.Name="Fim do corte"
                                     LostKeyboardFocus="TimecodeLostFocus" KeyDown="TimecodeKeyDown" Margin="0,0,8,4"/>
                            <Button x:Name="ResetTrimButton" Content="Vídeo inteiro" Click="ResetTrim" Padding="8,5" Margin="0,0,8,4"/>
                            <TextBlock x:Name="TrimLabel" Text="" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelStyle}" Padding="12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <CheckBox x:Name="NrSwitch" DockPanel.Dock="Right" IsChecked="True" Style="{StaticResource Switch}" Click="ToggleNr" AutomationProperties.Name="Ativar melhoria NR"/>
                                <TextBlock Text="Melhoria NR" FontSize="17" FontWeight="SemiBold"/>
                            </DockPanel>
                            <TextBlock x:Name="LayerSummary" Text="1 camada ativa" Style="{StaticResource Secondary}" Margin="0,4,0,12"/>
                            <TextBlock Text="Modelo de NR" Style="{StaticResource Secondary}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="NrVersion" SelectionChanged="ChangeVersion" Margin="0,0,0,10" AutomationProperties.Name="Modelo de NR">
                                <ComboBoxItem Content="Vídeo e animação" Tag="realesr-animevideov3"/>
                                <ComboBoxItem Content="Imagem real" Tag="realesrgan-x4plus"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="AddLayerButton" DockPanel.Dock="Bottom" Content="+ Adicionar camada NR" Click="AddLayerClick" Margin="0,8,0,0"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="LayerCards"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,9,0,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Configurações de saída" FontSize="16" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,9,0,0">
                            <ComboBox x:Name="Codec" DockPanel.Dock="Right" Width="100" SelectedIndex="0" AutomationProperties.Name="Codec de vídeo">
                                <ComboBoxItem Content="H.264"/><ComboBoxItem Content="HEVC"/>
                            </ComboBox>
                            <TextBlock Text="MP4 · Codec" VerticalAlignment="Center" Style="{StaticResource Secondary}"/>
                        </DockPanel>
                        <ProgressBar Background="{StaticResource ControlFill}" BorderBrush="{StaticResource Line}" x:Name="Progress" Height="5" Minimum="0" Maximum="10000" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button x:Name="ExportButton" Content="Iniciar exportação" Style="{StaticResource Primary}" Click="ExportClick"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Click="CancelWork" Margin="6,0,0,0" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="2,8,2,0" LastChildFill="True">
            <Button x:Name="ShowOutputButton" Content="Abrir pasta de saída" DockPanel.Dock="Right" Padding="8,3" Click="OpenOutput" Visibility="Collapsed"/>
            <TextBlock x:Name="Status" Text="Adicione um vídeo para começar." Style="{StaticResource Secondary}" Margin="0,3,8,0" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
