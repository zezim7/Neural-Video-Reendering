<Window x:Class="VideoNR.Editor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Video NR"
        Width="1340" Height="820" MinWidth="920" MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        Icon="Assets/VideoNR.ico"
        PreviewKeyDown="EditorKeyDown"
        AllowDrop="True"
        Drop="DropFiles">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- Integrated Windows 11 Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Emblem + Commands -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Bespoke Viewfinder Emblem -->
                    <Border Width="20" Height="20" CornerRadius="4" Background="#161616" BorderBrush="#333333" BorderThickness="1" Margin="0,0,8,0">
                        <Grid>
                            <Path Data="M 4 7 V 4 H 7 M 11 4 H 14 V 7 M 4 11 V 14 H 7 M 11 14 H 14 V 11"
                                  Stroke="#ECECEC" StrokeThickness="1.3" Stretch="None"/>
                            <Polygon Points="9,6.2 11.8,9 9,11.8 6.2,9" Fill="{StaticResource Accent}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Video NR" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>

                    <Border Width="1" Height="16" Background="{StaticResource BorderSubtle}" Margin="12,0,6,0"/>

                    <Button x:Name="QueueToggleButton" Style="{StaticResource TitleBarButton}" Click="ToggleQueueClick"
                            Padding="8,5" Margin="0,0,2,0" ToolTip="Mostrar ou ocultar fila (Q)">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8A0;" FontSize="13"/>
                    </Button>
                    <Button x:Name="TopOpenButton" Style="{StaticResource TitleBarButton}" Click="AddFiles"
                            Margin="0,0,2,0" ToolTip="Adicionar vídeos à fila (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE838;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Abrir" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ScreenPrintButton" Style="{StaticResource TitleBarButton}" Click="ScreenPrintClick"
                            Margin="0,0,2,0" ToolTip="Capturar tela e aplicar DLSS 5 / NR (Ctrl+Shift+P)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7A8;" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,6,0"/>
                            <TextBlock Text="Print de tela" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImagePrintButton" Style="{StaticResource TitleBarButton}" Click="ImagePrintClick"
                            ToolTip="Abrir imagem (PNG/JPG/BMP) ou colar (Ctrl+V) e aplicar DLSS 5 / NR">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xEB9F;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Imagem" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: Live Clip Info (Draggable Caption Area) -->
                <TextBlock x:Name="HeaderClipInfo" Grid.Column="1" Text=""
                           Style="{StaticResource SecondaryText}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="16,0" IsHitTestVisible="False"/>

                <!-- Right: Engine Indicator + Window Caption Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse x:Name="EngineDot" Width="6" Height="6" Fill="{StaticResource StatusOk}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="EngineLabel" Text="Motor NR" FontSize="11.5" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"/>
                        <Button x:Name="EngineButton" Style="{StaticResource TitleBarButton}" Content="Localizar motor"
                                Visibility="Collapsed" Click="FindEngineClick" Padding="8,4" Margin="6,0,0,0" FontSize="11.5"/>
                    </StackPanel>

                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeClick" ToolTip="Minimizar">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE921;" FontSize="10"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeClick" ToolTip="Maximizar / Restaurar">
                        <TextBlock x:Name="MaximizeIcon" Style="{StaticResource IconGlyph}" Text="&#xE922;" FontSize="10"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseClick" ToolTip="Fechar">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8BB;" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Mastering Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="QueueColumn" Width="248" MinWidth="0"/>
                <ColumnDefinition x:Name="QueueSplitterColumn" Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="440"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="316" MinWidth="270"/>
            </Grid.ColumnDefinitions>

            <!-- Collapsible Queue Drawer -->
            <Border x:Name="QueuePane" Grid.Column="0" Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,10,10,10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="AddButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="AddFiles"
                                    ToolTip="Adicionar vídeos à fila (Ctrl+O)">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="11"/>
                            </Button>
                            <TextBlock x:Name="QueueTitle" Text="Fila · 0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="10,8" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RemoveButton" Style="{StaticResource DangerButton}" Click="RemoveSelected" Padding="8,5" FontSize="11.5" Margin="0,0,6,0" ToolTip="Remover selecionado (Delete)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" FontSize="11" Margin="0,0,5,0"/>
                                    <TextBlock Text="Remover" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearButton" Grid.Column="1" Content="Limpar" Click="ClearQueue" Padding="10,5" FontSize="11.5"/>
                        </Grid>
                    </Border>

                    <Grid Margin="6">
                        <StackPanel x:Name="EmptyQueue" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE714;" FontSize="22" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <TextBlock Text="Fila vazia" FontWeight="SemiBold" HorizontalAlignment="Center" Style="{StaticResource SecondaryText}" FontSize="12"/>
                            <TextBlock Text="Solte vídeos ou pastas aqui" HorizontalAlignment="Center" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" TextAlignment="Center"/>
                        </StackPanel>

                        <ListBox x:Name="Queue" Background="Transparent" BorderThickness="0" SelectionChanged="SelectClip" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="56" Height="32" CornerRadius="3"
                                                Background="{StaticResource ViewportBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                                Margin="0,0,9,0" ClipToBounds="True" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE714;" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border Background="#CC111111" CornerRadius="2" Padding="3,0.5"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ResolutionBadge}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ResolutionBadge}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="9" Foreground="{StaticResource TextPrimary}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="QueueSplitter" Grid.Column="1" Width="5" Style="{StaticResource HairlineSplitter}" ResizeDirection="Columns"/>

            <!-- Dominant Center Viewport & Precision Transport -->
            <Grid Grid.Column="2" Background="{StaticResource WindowBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Preview Stage -->
                <Border Background="{StaticResource ViewportBg}" Margin="10,10,6,10" CornerRadius="4"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" ClipToBounds="True"
                        MouseLeftButtonUp="PreviewClick">
                    <Grid>
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" ScrubbingEnabled="True"
                                      MediaOpened="MediaReady" MediaFailed="MediaFailure" MediaEnded="MediaFinished"/>

                        <StackPanel x:Name="VideoPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE714;" FontSize="26" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="VideoMessage" Text="Arraste um vídeo ou imagem" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock x:Name="VideoSubMessage" Text="MP4, MKV, MOV ou imagem PNG / JPG" Style="{StaticResource SecondaryText}" FontSize="12" TextAlignment="Center" Margin="0,4,0,16"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="EmptyOpenButton" Content="Abrir vídeo" Style="{StaticResource PrimaryButton}" Click="AddFiles" Padding="16,7" Margin="0,0,8,0"/>
                                <Button x:Name="EmptyPrintButton" Content="Print de tela" Click="ScreenPrintClick" Padding="14,7"/>
                            </StackPanel>
                            <TextBlock Text="Ctrl+O · Ctrl+Shift+P · Ctrl+V" Style="{StaticResource MonoText}" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>

                        <Border x:Name="VideoTag" Visibility="Collapsed" Background="{StaticResource OverlayBg}" BorderBrush="{StaticResource BorderControl}"
                                BorderThickness="1" Padding="8,3" CornerRadius="3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="Original" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Precision Trim & Transport Deck -->
                <Border Grid.Row="1" Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="14,9,14,11">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Text="00:00:00.000 / 00:00:00.000"
                                       Style="{StaticResource MonoText}" FontSize="11.5" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CORTE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TrimLabel" Text="" Style="{StaticResource SecondaryText}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <Canvas x:Name="RulerCanvas" Height="16" Margin="5,6,5,2" ClipToBounds="True" IsHitTestVisible="False"/>

                        <Border Background="{StaticResource RecessedBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4">
                            <Canvas x:Name="TrimTrack" Height="34" Margin="5,0" Background="Transparent" SizeChanged="ResizeTrim"
                                    MouseLeftButtonDown="ScrubDown" MouseLeftButtonUp="ScrubUp" MouseMove="ScrubMove" LostMouseCapture="ScrubLost">
                                <Border x:Name="TrimMaskLeft" Canvas.Top="1" Height="32" Background="{StaticResource TrimMaskBg}" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <Border x:Name="TrimMaskRight" Canvas.Top="1" Height="32" Background="{StaticResource TrimMaskBg}" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <Border x:Name="TrimRange" Canvas.Top="2" Height="30" CornerRadius="2" Background="{StaticResource AccentRangeFill}"
                                        BorderBrush="{StaticResource Accent}" BorderThickness="0,1.5" IsHitTestVisible="False" Panel.ZIndex="1"/>
                                <Grid x:Name="Playhead" Width="9" Height="34" IsHitTestVisible="False" Panel.ZIndex="2">
                                    <Polygon Points="0,0 9,0 4.5,5" Fill="{StaticResource PrimaryFill}" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <Border Width="1.5" Height="30" Background="{StaticResource PrimaryFill}" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                </Grid>
                                <Thumb x:Name="StartHandle" Style="{StaticResource TrimHandle}" Canvas.Top="1" Panel.ZIndex="3" Tag="start" DragStarted="TrimDragStarted"
                                       DragDelta="TrimDrag" ToolTip="Arraste o início do trecho" AutomationProperties.Name="Alça de início do corte"/>
                                <Thumb x:Name="EndHandle" Style="{StaticResource TrimHandle}" Canvas.Top="1" Panel.ZIndex="3" Tag="end" DragStarted="TrimDragStarted"
                                       DragDelta="TrimDrag" ToolTip="Arraste o fim do trecho" AutomationProperties.Name="Alça de fim do corte"/>
                            </Canvas>
                        </Border>

                        <DockPanel Margin="0,9,0,0" LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PlayButton" Click="PlayClick" Padding="10,5" Margin="0,0,4,0" ToolTip="Reproduzir ou pausar (Espaço)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="PlayIcon" Style="{StaticResource IconGlyph}" Text="&#xE768;" FontSize="11" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="PlayLabel" Text="Reproduzir" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StepBackFrameButton" Style="{StaticResource IconButton}" Click="StepBackFrameClick" Padding="8,5" Margin="0,0,2,0" ToolTip="Voltar 1 frame (,)">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE892;" FontSize="11"/>
                                </Button>
                                <Button x:Name="StepForwardFrameButton" Style="{StaticResource IconButton}" Click="StepForwardFrameClick" Padding="8,5" Margin="0,0,5,0" ToolTip="Avançar 1 frame (.)">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE893;" FontSize="11"/>
                                </Button>
                                <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Click="MuteClick" Padding="8,5" Margin="0,0,6,0" ToolTip="Silenciar ou ativar áudio (M)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="MuteIcon" Style="{StaticResource IconGlyph}" Text="&#xE767;" FontSize="12" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="MuteLabel" Text="Som" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FramePrintButton" Click="FramePrintClick" Padding="10,5" ToolTip="Renderizar frame atual com DLSS 5 / NR (P)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE722;" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,0,6,0"/>
                                        <TextBlock Text="Print DLSS 5" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="MarkStartButton" Content="[" FontFamily="{StaticResource MonoFont}" Click="MarkStartClick" Padding="8,5" FontSize="12" Margin="0,0,5,0" ToolTip="Marcar início no ponto atual (I)"/>
                                <TextBox x:Name="StartTime" Tag="start" Style="{StaticResource TimecodeBox}" AutomationProperties.Name="Início do corte"
                                         LostKeyboardFocus="TimecodeLostFocus" KeyDown="TimecodeKeyDown"/>
                                <TextBlock Text="–" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="5,0"/>
                                <TextBox x:Name="EndTime" Tag="end" Style="{StaticResource TimecodeBox}" AutomationProperties.Name="Fim do corte"
                                         LostKeyboardFocus="TimecodeLostFocus" KeyDown="TimecodeKeyDown"/>
                                <Button x:Name="MarkEndButton" Content="]" FontFamily="{StaticResource MonoFont}" Click="MarkEndClick" Padding="8,5" FontSize="12" Margin="5,0,5,0" ToolTip="Marcar fim no ponto atual (O)"/>
                                <Button x:Name="ResetTrimButton" Style="{StaticResource IconButton}" Click="ResetTrim" Padding="8,5" ToolTip="Voltar para o vídeo inteiro">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" FontSize="11.5"/>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Style="{StaticResource HairlineSplitter}" ResizeDirection="Columns"/>

            <!-- Technical NR Inspector & Export Dock -->
            <Border Grid.Column="4" Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <!-- Export Dock -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="14,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" Background="{StaticResource RecessedBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="H264Radio" Content="H.264" GroupName="CodecGroup" IsChecked="True" Style="{StaticResource SegmentedOption}" AutomationProperties.Name="Codec H.264"/>
                                        <RadioButton x:Name="HevcRadio" Content="HEVC" GroupName="CodecGroup" Style="{StaticResource SegmentedOption}" AutomationProperties.Name="Codec HEVC"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SAÍDA MP4" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="Preserva FPS e áudio" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>

                            <ProgressBar x:Name="Progress" Height="3" Minimum="0" Maximum="10000" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ExportButton" Content="Exportar vídeo" Style="{StaticResource PrimaryButton}" Click="ExportClick" Height="34"/>
                                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Style="{StaticResource DangerButton}" Click="CancelWork" Margin="8,0,0,0" Height="34" Visibility="Collapsed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- NR Header, Model Picker & Quick Presets -->
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
                        <DockPanel>
                            <CheckBox x:Name="NrSwitch" DockPanel.Dock="Right" IsChecked="True" Style="{StaticResource Switch}" Click="ToggleNr" AutomationProperties.Name="Ativar melhoria NR"/>
                            <StackPanel>
                                <TextBlock Text="Renderização Neural" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LayerSummary" Text="1 camada ativa" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="MODELO NR" Style="{StaticResource SectionLabel}" Margin="0,12,0,5"/>
                        <ComboBox x:Name="NrVersion" DisplayMemberPath="Label" SelectionChanged="ChangeVersion" AutomationProperties.Name="Versão do NR"/>

                        <TextBlock Text="PREDEFINIÇÃO" Style="{StaticResource SectionLabel}" Margin="0,11,0,5"/>
                        <Grid x:Name="PresetsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Sutil" Tag="0" Style="{StaticResource PresetButton}" Click="ApplyPresetClick" ToolTip="Ajuste leve para preservar grão natural"/>
                            <Button Grid.Column="2" Content="Equilibrado" Tag="1" Style="{StaticResource PresetButton}" Click="ApplyPresetClick" ToolTip="Equilíbrio entre nitidez e naturalidade"/>
                            <Button Grid.Column="4" Content="Máximo" Tag="2" Style="{StaticResource PresetButton}" Click="ApplyPresetClick" ToolTip="Intensidade máxima (1.00)"/>
                        </Grid>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="14,6,14,10">
                        <Button x:Name="AddLayerButton" Click="AddLayerClick" Padding="10,6" FontSize="12" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="10.5" Foreground="{StaticResource Accent}" Margin="0,0,7,0"/>
                                <TextBlock Text="Adicionar camada" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Scrollable NR Layer Stack -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,0,14,4">
                        <ItemsControl x:Name="LayerCards">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBg}" BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="4" Margin="0,0,0,6" Padding="10,8">
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled, Mode=TwoWay}" Style="{StaticResource Switch}"
                                                          VerticalAlignment="Center" Margin="6,0,0,0" Click="LayerToggleClick"
                                                          AutomationProperties.Name="{Binding ToggleAccessibilityName}"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Duplicar camada"
                                                        VerticalAlignment="Center" IsEnabled="{Binding CanDuplicate}" Click="DuplicateLayerClick"
                                                        AutomationProperties.Name="{Binding DuplicateAccessibilityName}">
                                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8C8;" FontSize="11.5" Foreground="{StaticResource TextSecondary}"/>
                                                </Button>
                                                <Button Style="{StaticResource SubtleButton}" Padding="3,2,6,2" Margin="0,0,4,0"
                                                        Click="ToggleLayerExpandClick" ToolTip="Abrir ajustes da camada"
                                                        AutomationProperties.Name="{Binding HeaderAccessibilityName}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,7,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xE76C;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                                            <Setter Property="Text" Value="&#xE70D;"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryText}" FontSize="11"/>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DockPanel>

                                            <StackPanel Margin="2,9,2,2" Visibility="{Binding Expanded, Converter={StaticResource BoolToVisibility}}">
                                                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,0,0,9"/>
                                                <TextBlock Text="RESOLUÇÃO INTERNA" Style="{StaticResource SectionLabel}" Margin="0,0,0,5"/>
                                                <ComboBox ItemsSource="{Binding AvailableResolutions}" SelectedIndex="{Binding ResolutionIndex, Mode=TwoWay}"/>

                                                <StackPanel Margin="0,10,0,0">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding IntensityValue}" Style="{StaticResource MonoText}" FontSize="11"/>
                                                        <TextBlock Text="Intensidade" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="1" Value="{Binding Intensity, Mode=TwoWay}" Tag="Intensity"
                                                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                            PreviewMouseDoubleClick="SliderResetDoubleClick"
                                                            ToolTip="Duplo-clique para restaurar 1.00" AutomationProperties.Name="Intensidade"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,8,0,0">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ToneValue}" Style="{StaticResource MonoText}" FontSize="11"/>
                                                        <TextBlock Text="Tom" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="1" Value="{Binding Tone, Mode=TwoWay}" Tag="Tone"
                                                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                            PreviewMouseDoubleClick="SliderResetDoubleClick"
                                                            ToolTip="Duplo-clique para restaurar 1.00" AutomationProperties.Name="Tom"/>
                                                </StackPanel>

                                                <StackPanel Margin="0,8,0,0">
                                                    <DockPanel Margin="0,0,0,2">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StructureValue}" Style="{StaticResource MonoText}" FontSize="11"/>
                                                        <TextBlock Text="Estrutura" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                                    </DockPanel>
                                                    <Slider Minimum="0" Maximum="1" Value="{Binding Structure, Mode=TwoWay}" Tag="Structure"
                                                            TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                            PreviewMouseDoubleClick="SliderResetDoubleClick"
                                                            ToolTip="Duplo-clique para restaurar 1.00" AutomationProperties.Name="Estrutura"/>
                                                </StackPanel>

                                                <Button Style="{StaticResource DangerButton}" Padding="9,4" FontSize="11"
                                                        HorizontalAlignment="Right" Margin="0,10,0,0" Click="RemoveLayerClick">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" FontSize="11" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Remover" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Minimal Status Strip -->
        <Border Grid.Row="2" Background="{StaticResource StatusBarBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel LastChildFill="True">
                <Button x:Name="ShowOutputButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="8,2" Click="OpenOutput" Visibility="Collapsed" FontSize="11">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE838;" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,6,0"/>
                        <TextBlock Text="Abrir pasta de saída" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="Status" Text="Pronto." Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
