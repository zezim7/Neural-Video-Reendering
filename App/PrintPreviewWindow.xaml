<Window x:Class="VideoNR.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualização DLSS 5 / NR"
        Width="1120" Height="760" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        Icon="Assets/VideoNR.ico"
        PreviewKeyDown="PreviewKeyDownHandler">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <!-- Integrated Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{StaticResource RecessedBg}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="4" Padding="2" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CompareRadio" Content="Comparar" GroupName="ViewMode"
                                         Style="{StaticResource SegmentedOption}" Checked="ViewModeChanged"/>
                            <RadioButton x:Name="EnhancedRadio" Content="NR (DLSS 5)" GroupName="ViewMode"
                                         Style="{StaticResource SegmentedOption}" Checked="ViewModeChanged"/>
                            <RadioButton x:Name="OriginalRadio" Content="Original" GroupName="ViewMode"
                                         Style="{StaticResource SegmentedOption}" Checked="ViewModeChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource RecessedBg}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="4" Padding="2" Margin="8,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FitZoomRadio" Content="Ajustar" GroupName="ZoomMode" IsChecked="True"
                                         Style="{StaticResource SegmentedOption}" Checked="ZoomModeChanged"/>
                            <RadioButton x:Name="ActualZoomRadio" Content="100%" GroupName="ZoomMode"
                                         Style="{StaticResource SegmentedOption}" Checked="ZoomModeChanged" ToolTip="Inspeção pixel a pixel (1:1)"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="MetadataLabel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource SecondaryText}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Margin="14,0" IsHitTestVisible="False"/>

                <Button Grid.Column="2" Style="{StaticResource CloseCaptionButton}" Height="42" Click="CloseClick" ToolTip="Fechar (Esc)">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8BB;" FontSize="10"/>
                </Button>
            </Grid>
        </Border>

        <!-- Comparison Viewport -->
        <Border Grid.Row="1" Background="{StaticResource ViewportBg}" Margin="10" CornerRadius="4"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" ClipToBounds="True">
            <ScrollViewer x:Name="StageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                          Background="Transparent" SizeChanged="StageSizeChanged">
                <Grid x:Name="StageHost" Background="Transparent"
                      MouseLeftButtonDown="StageMouseDown" MouseMove="StageMouseMove"
                      MouseLeftButtonUp="StageMouseUp" LostMouseCapture="StageLostCapture">
                    <Grid x:Name="ViewportGrid" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                        <Image x:Name="EnhancedImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="OriginalImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry x:Name="OriginalClip"/>
                            </Image.Clip>
                        </Image>

                        <Canvas x:Name="DividerOverlay" IsHitTestVisible="False">
                            <Border x:Name="SplitLine" Width="1.5" Background="{StaticResource Accent}"/>
                            <Border x:Name="SplitKnob" Width="26" Height="26" CornerRadius="13"
                                    Background="{StaticResource Accent}" BorderBrush="#121212" BorderThickness="1.5">
                                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8AB;" FontSize="11" Foreground="#121212"/>
                            </Border>
                        </Canvas>

                        <Border x:Name="OriginalPill" Background="{StaticResource OverlayBg}" BorderBrush="{StaticResource BorderControl}" BorderThickness="1"
                                CornerRadius="3" Padding="8,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsHitTestVisible="False">
                            <TextBlock Text="Original" FontSize="11" FontWeight="SemiBold"/>
                        </Border>

                        <Border x:Name="NrPill" Background="{StaticResource AccentSubtle}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                CornerRadius="3" Padding="8,3" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsHitTestVisible="False">
                            <TextBlock Text="DLSS 5 / NR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHover}"/>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource ChromeBg}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="14,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="CopyClick" Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Copiar"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="SavePngClick" Margin="0,0,8,0" Padding="13,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74E;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Salvar PNG"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Salvar JPG" Click="SaveJpgClick" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="Fechar" Click="CloseClick" Padding="12,6"/>
                </StackPanel>

                <TextBlock x:Name="PreviewStatus" Text="Arraste a linha âmbar para comparar antes e depois."
                           Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
