<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VideoNR</AssemblyName>
    <AssemblyTitle>Video NR</AssemblyTitle>
    <Product>Video NR</Product>
    <Description>Editor e aprimorador neural de vídeo offline</Description>
    <ApplicationIcon>Assets\VideoNR.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VideoNR.WindowsTests" />
    <Resource Include="Assets\VideoNR.ico" />
  </ItemGroup>
</Project>
